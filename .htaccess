# Server configuration for the genx-dos.fun host (LiteSpeed, which reads
# .htaccess). Deployed by deploy.sh; deliberately NOT part of the release zip,
# which is served by `python3 -m http.server` and ignores this file entirely.
#
# That split is why the site's Content-Security-Policy lives in a <meta> tag
# rather than here: the meta travels with the files, so the zip gets the same
# policy as the website. Anything below is what a meta tag cannot express.
# The two compose by INTERSECTION — a header can only narrow what the meta
# already allows, never widen it.

# ---------------------------------------------------------------------------
# Response headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 'always' so these are attached to error responses too, not just 200s.

    # frame-ancestors cannot be set from a meta tag — it is ignored there — so
    # this is the only place the site can say who may frame it. A policy
    # containing just this one directive narrows framing without touching
    # anything the meta policy permits.
    Header always set Content-Security-Policy "frame-ancestors 'self'"

    # Serve every file as the type it was declared, never as something guessed
    # from its contents. The site serves a lot of unusual extensions (.ssd,
    # .d64, .atr, .prg, .rom) whose bytes a sniffer could mistake for markup.
    Header always set X-Content-Type-Options "nosniff"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # fullscreen and gamepad MUST stay enabled — the emulators need fullscreen
    # and genx-gamepad-keys.js needs the Gamepad API. Everything else the site
    # never uses is switched off.
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=(), fullscreen=(self), gamepad=(self)"

    # Deliberately short. This plan has no AutoSSL (uapi reports the feature is
    # absent), so certificate renewal is Namecheap's to do rather than
    # something the account can trigger — and if a cert ever lapsed, a long
    # max-age would leave returning visitors unable to reach the site at all,
    # with no way to click through. Raise to 15552000 (180 days) once a renewal
    # has been observed to happen cleanly.
    Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# The host sent no cache headers at all, which left every file on heuristic
# caching — the browser guessing a lifetime from how long ago the file was
# modified. That produced the worst possible failure for a site deployed by
# rsync under stable filenames: fresh HTML running a stale copy of a shared
# script. It cost real time during two deploys, where a change looked like it
# had not shipped until a hard reload proved otherwise, and a visitor gets no
# hard reload.
#
# Nothing here is versioned or content-hashed, so nothing can be cached
# immutably. The rule below is therefore "keep it, but ask first": no-cache
# does not mean do not store — it means revalidate on every use. This host
# sends no ETag (checked: none on any response), so revalidation rides on
# Last-Modified, which rsync preserves from the local file. An unchanged file
# answers 304 with no body — measured at 0 bytes on staging — so a repeat
# visit costs a round trip and nothing else, and a changed file is never
# missed.
<IfModule mod_headers.c>
    # Everything that decides how the site looks and behaves, plus the
    # machine images that change whenever a game or a core is rebuilt.
    <FilesMatch "\.(html|js|mjs|css|json|wasm|data|map)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>

    # ROMs, discs, tapes and cartridges: same reasoning — a swapped game keeps
    # its filename, so a cached copy would outlive the change.
    <FilesMatch "\.(bin|rom|prg|d64|ssd|dsd|atr|woz|hex|tap|cas|col|a26|a78|gg|gb|gbc|nes|sms|lnx|vec|zip|rpk|img|p)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>

    # Fonts are the one genuinely immutable class here: subsetted, named for
    # what they are, and unchanged since they shipped. A month spares repeat
    # visitors the round trips.
    <FilesMatch "\.(woff|woff2|ttf|otf)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Bezels, wallpaper, screenshots and the favicon. These do change — a
    # bezel gets re-cut now and then — so a week rather than a year, which is
    # long enough to matter on a page carrying a 1 MB photograph and short
    # enough that a correction is not stuck out there.
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|mp3|ogg|wav|m4a|mp4|webm)$">
        Header always set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Error pages
# ---------------------------------------------------------------------------
# Leading slash = server-relative, so these resolve from any depth. 403 earns
# its keep here: with listings off, every directory without an index answers
# 403 rather than 404.
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# ---------------------------------------------------------------------------
# Directory listings
# ---------------------------------------------------------------------------
# The host has autoindex on by default, which turns every directory without an
# index file into a browsable listing — /systems/<machine>/games/ handed out the
# whole library, and /styles/fonts/ the whole font set.
Options -Indexes

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/wasm
</IfModule>

# ---------------------------------------------------------------------------
# Content types
# ---------------------------------------------------------------------------
# application/wasm is already a system MIME type on this host, but stating it
# here means a move to a host where it isn't cannot silently stop every
# emulator from starting.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# ---------------------------------------------------------------------------
# Dotfiles
# ---------------------------------------------------------------------------
# Nothing beginning with a dot is ever meant to be fetched, with the single
# exception of .well-known, which certificate validation uses.
RedirectMatch 404 ^/\.(?!well-known)
