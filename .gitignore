systems/*/node_modules/

# macOS filesystem junk — sometimes ships inside upstream emulator
# bundles we mirror; never wanted in this repo.
.DS_Store
._*
__MACOSX/
.AppleDouble/
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
Icon?


# Local Claude Code worktrees/settings and dev-only probe
.claude/
_paddiag.html

# portable-site build staging
/dist/
/npm-pkg/

# The working portable copy, kept refreshed alongside the repo (moved here
# from the Desktop 07/08/2026). It is a full duplicate of the served site —
# never commit it, never let a build recurse into it.
/_Portable/

# release artefacts — built at a cut, attached to the GitHub release
GenX-DOS-v*.zip

# Games and firmware that didn't come with their emulators. They are not in the
# repository: they stay in the working tree, untracked, so deploy.sh still
# ships them to genx-dos.fun, and build-portable.sh --no-roms leaves them out
# of the release zip. ROMS.txt lists them for anyone completing a copy. Files an
# emulator's own maintainer shipped with it are tracked as normal.
/systems/apple2/json/disks/archon.json
/systems/apple2/json/disks/aztec.json
/systems/apple2/json/disks/choplift.json
/systems/apple2/json/disks/hardhat.json
/systems/apple2/json/disks/karateka.json
/systems/apple2/json/disks/lemonade.json
/systems/apple2/json/disks/loderun.json
/systems/apple2/json/disks/oregon.json
/systems/apple2/json/disks/sammy.json
/systems/apple2/json/disks/wolf.json
/systems/apple2/woz/
/systems/arcade/games/

# IBM PC — the ten DOS games are ours to serve, not ours to redistribute.
